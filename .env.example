# Database
DATABASE_URL=postgres://postgres:CHANGE_ME@postgres:5432/crud?sslmode=disable
POSTGRES_PASSWORD=CHANGE_ME

# JWT Secret (REQUIRED - generate a strong random key)
JWT_SECRET=change-this-to-a-strong-random-secret-at-least-32-chars

# Encryption key for CPF (optional - if empty, CPF is stored in plain text)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# XBZ API
XBZ_CNPJ=
XBZ_TOKEN=

# E-mail automático para fornecedores (opcional em desenvolvimento)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# TLS/HTTPS (optional - if both are set, server starts with TLS)
TLS_CERT_FILE=
TLS_KEY_FILE=
