# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/crud?sslmode=disable
POSTGRES_PASSWORD=postgres

# JWT Secret (REQUIRED - generate a strong random key)
JWT_SECRET=change-this-to-a-strong-random-secret-at-least-32-chars

# Encryption key for CPF (optional)
ENCRYPTION_KEY=

# XBZ API
XBZ_CNPJ=
XBZ_TOKEN=

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# TLS/HTTPS (optional)
TLS_CERT_FILE=
TLS_KEY_FILE=

# CORS
CORS_ALLOWED_ORIGINS=

# Logging: "plain" or "json"
LOG_FORMAT=plain
RUST_LOG=info
